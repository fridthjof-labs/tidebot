{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tidebot",
  "main": "./src/runtime/worker.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "workers_dev": true,
  "env": {
    "preview": {
      "name": "tidebot-preview",
      "workers_dev": true
    }
  }
}
