{
  "name": "tidebot",
  "version": "0.1.0",
  "description": "Prow-inspired GitHub repository automation without Kubernetes: labels, slash commands, auto-approve, and Tide-style auto-merge.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "tidebot": "./dist/cli/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "tidebot": "tsx src/cli/index.ts",
    "serve": "tsx src/cli/index.ts serve",
    "deploy:workers": "wrangler deploy"
  },
  "dependencies": {
    "@octokit/app": "^16.1.2",
    "@octokit/auth-app": "^8.2.0",
    "@octokit/rest": "^22.0.1",
    "@octokit/webhooks": "^14.2.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@cloudflare/workers-types": "^5.20260714.1",
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.45.0"
  },
  "packageManager": "pnpm@11.15.1"
}
